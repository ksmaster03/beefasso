{
  "name": "beefasso",
  "version": "0.0.1",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:app": "bun run --cwd apps/app dev",
    "build": "bun run --cwd apps/app build",
    "typecheck": "bun run --filter '*' typecheck",
    "db:push": "bun run --cwd packages/db push",
    "db:studio": "bun run --cwd packages/db studio",
    "db:rls": "bun run --cwd packages/db rls"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "prettier": "^3.4.2",
    "@types/bun": "^1.1.14"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
