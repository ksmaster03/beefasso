    "hono": "^4.6.14",
    "@hono/zod-validator": "^0.4.2",
    "drizzle-orm": "^0.38.3",
    "zod": "^3.24.1",
    "jose": "^5.9.6",
    "bcryptjs": "^2.4.3",
    "promptpay-qr": "^0.5.0",
    "qrcode": "^1.5.4",
    "pdfkit": "^0.15.2"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/bcryptjs": "^2.4.6",
